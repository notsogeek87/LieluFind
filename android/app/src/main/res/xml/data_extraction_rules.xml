<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : sauvegarde cloud (Google, Samsung) et transfert d'appareil à appareil. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_flutter/dawarich_db.sqlite" />
        <include domain="root" path="app_flutter/lielu_backup_secrets.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/dawarich_db.sqlite" />
        <include domain="root" path="app_flutter/lielu_backup_secrets.json" />
    </device-transfer>
</data-extraction-rules>
